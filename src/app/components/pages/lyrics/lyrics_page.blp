using Gtk 4.0;
using Adw 1;

template $LyricsPageWidget : Adw.Bin {
  child: Box {
    orientation: vertical;

    Stack lyrics_stack {
      vexpand: true;

      styles [
        "lyrics-page__content",
      ]

      StackPage {
        name: "loading";

        child: Adw.StatusPage loading_page {
          icon-name: "audio-x-generic-symbolic";
          /* Translators: Shown when fetching song lyrics. */
          title: _("Loading Lyrics…");

          styles [
            "compact",
          ]
        };
      }

      StackPage {
        name: "list";

        child: ScrolledWindow lyrics_scroller {
          hscrollbar-policy: never;
          vexpand: true;

          Box lyrics_container {
            orientation: vertical;
            valign: start;
            margin-top: 24;
            margin-bottom: 48;
            margin-start: 16;
            margin-end: 16;
            spacing: 8;
          }
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "audio-x-generic-symbolic";
          /* Translators: Shown when no lyrics are found. */
          title: _("No Lyrics Available");
          description: _("Lyrics couldn't be found for this song.");

          styles [
            "compact",
          ]

          child: Button reload_empty_button {
            halign: center;
            visible: false;
            /* Translators: Button to retry fetching lyrics from LRCLIB. */
            label: _("Reload Lyrics");

            styles [
              "pill",
            ]
          };
        };
      }
    }

    Box sync_toolbar {
      orientation: horizontal;
      halign: center;
      spacing: 4;
      visible: false;

      styles [
        "lyric-sync-bar",
      ]

      Button offset_minus_button {
        label: "-100 ms";
        tooltip-text: _("Delay lyrics (-100 ms)");

        styles [
          "flat",
          "circular",
        ]
      }

      Button offset_reset_button {
        label: "0 ms";
        tooltip-text: _("Reset lyrics sync offset");

        styles [
          "flat",
          "lyric-sync-offset",
        ]
      }

      Button offset_plus_button {
        label: "+100 ms";
        tooltip-text: _("Advance lyrics (+100 ms)");

        styles [
          "flat",
          "circular",
        ]
      }

      Separator {
        orientation: vertical;
        margin-top: 4;
        margin-bottom: 4;
      }

      Button reload_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Reload lyrics");

        styles [
          "flat",
          "circular",
        ]
      }

      ToggleButton translate_button {
        icon-name: "canto-translate-symbolic";
        /* Translators: Tooltip of the lyrics button that shows a translation under each line. */
        tooltip-text: _("Translate Lyrics");

        styles [
          "flat",
          "circular",
        ]
      }

      MenuButton translate_language_button {
        icon-name: "pan-down-symbolic";
        /* Translators: Tooltip of the button that picks the language lyrics are translated into. */
        tooltip-text: _("Translation Language");

        styles [
          "flat",
          "circular",
          "lyrics-translate-language",
        ]
      }

      Button fullscreen_button {
        icon-name: "view-fullscreen-symbolic";
        /* Translators: Tooltip of the button in the lyrics that shows them full screen. */
        tooltip-text: _("Full-Screen Lyrics");
        action-name: "win.fullscreen-lyrics";

        styles [
          "flat",
          "circular",
        ]
      }
    }
  };
}
