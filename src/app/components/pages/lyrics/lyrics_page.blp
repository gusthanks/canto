using Gtk 4.0;
using Adw 1;

template $LyricsPageWidget : Adw.Bin {
  child: Box {
    orientation: vertical;

    Stack lyrics_stack {
      vexpand: true;

      styles [
        "lyrics-page__content",
      ]

      StackPage {
        name: "loading";

        child: Adw.StatusPage loading_page {
          icon-name: "audio-x-generic-symbolic";
          /* Translators: Shown when fetching song lyrics. */
          title: _("Loading Lyrics…");

          styles [
            "compact",
          ]
        };
      }

      StackPage {
        name: "list";

        child: Overlay {
          child: ScrolledWindow lyrics_scroller {
            hscrollbar-policy: never;
            vexpand: true;

            Box lyrics_column {
              orientation: vertical;
              valign: start;
              margin-top: 24;
              margin-bottom: 48;
              margin-start: 16;
              margin-end: 16;

              // Where the lyrics came from: one quiet line that scrolls away
              // with them. Outside the lines' box, so it never counts as a line
              Label lyrics_source {
                visible: false;
                halign: start;
                xalign: 0.0;
                ellipsize: end;

                styles [
                  "caption",
                  "dim-label",
                  "lyrics-source",
                ]
              }

              Box lyrics_container {
                orientation: vertical;
                spacing: 8;
              }
            }
          };

          [overlay]
          Revealer back_to_line_revealer {
            valign: end;
            halign: center;
            margin-bottom: 12;
            transition-type: crossfade;
            reveal-child: false;

            Button back_to_line_button {
              /* Translators: Floating button that scrolls the lyrics back to the line being sung. */
              label: _("Back to Current Line");

              styles [
                "pill",
                "osd",
                "lyrics-back-to-line",
              ]
            }
          }
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "audio-x-generic-symbolic";
          /* Translators: Shown when no lyrics are found. */
          title: _("No Lyrics Available");
          description: _("Lyrics couldn't be found for this song.");

          styles [
            "compact",
          ]

          child: Box {
            orientation: vertical;
            halign: center;
            spacing: 12;

            Button reload_empty_button {
              halign: center;
              visible: false;
              /* Translators: Button to retry fetching lyrics from LRCLIB. */
              label: _("Reload Lyrics");

              styles [
                "pill",
              ]
            }

            Button web_search_button {
              halign: center;
              visible: false;
              /* Translators: Button under "No Lyrics Available", when no lyrics source has the song: searches the web for its lyrics. */
              label: _("Search the Web");

              styles [
                "pill",
                "flat",
              ]
            }

            Button add_lyrics_button {
              halign: center;
              visible: false;
              /* Translators: Button under "No Lyrics Available": opens a window to type or paste the song's lyrics and publish them to LRCLIB. */
              label: _("Add Lyrics");

              styles [
                "pill",
                "flat",
              ]
            }
          };
        };
      }
    }

    Box sync_toolbar {
      orientation: horizontal;
      halign: center;
      spacing: 4;
      visible: false;

      styles [
        "lyric-sync-bar",
      ]

      // Translate and its language read as one control
      Box translate_group {
        styles [
          "linked",
          "lyrics-translate-group",
        ]

        ToggleButton translate_button {
          icon-name: "canto-translate-symbolic";
          /* Translators: Tooltip of the lyrics button that shows a translation under each line. */
          tooltip-text: _("Translate Lyrics");

          styles [
            "flat",
          ]
        }

        MenuButton translate_language_button {
          icon-name: "pan-down-symbolic";
          /* Translators: Tooltip of the button that picks the language lyrics are translated into. */
          tooltip-text: _("Translation Language");

          styles [
            "flat",
            "lyrics-translate-language",
          ]
        }
      }

      MenuButton sync_button {
        icon-name: "canto-lyrics-sync-symbolic";
        /* Translators: Tooltip of the lyrics button that opens how lyrics light up, scroll and are timed. */
        tooltip-text: _("Lyrics Options");

        styles [
          "flat",
          "circular",
          "lyric-sync-button",
        ]

        popover: Popover {
          child: Box {
            orientation: vertical;
            spacing: 8;
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Label {
              /* Translators: Heading in the lyrics options popover: how the line being sung lights up. */
              label: _("Highlight");
              xalign: 0.0;

              styles [
                "heading",
              ]
            }

            Adw.ToggleGroup highlight_toggle {
              active-name: "word";

              Adw.Toggle {
                name: "word";
                /* Translators: Lyrics highlight choice: the words light up one by one as they are sung. */
                label: _("Word by Word");
              }

              Adw.Toggle {
                name: "line";
                /* Translators: Lyrics highlight choice: the whole line lights up at once. */
                label: _("Whole Line");
              }
            }

            Label {
              /* Translators: Heading in the lyrics options popover: what the lyrics do after you scroll them by hand. */
              label: _("After You Scroll");
              xalign: 0.0;
              margin-top: 6;

              styles [
                "heading",
              ]
            }

            Adw.ToggleGroup scroll_toggle {
              active-name: "follow";

              Adw.Toggle {
                name: "follow";
                /* Translators: Lyrics scroll choice: a few seconds after scrolling by hand, the lyrics go back to the line being sung. */
                label: _("Follow the Song");
              }

              Adw.Toggle {
                name: "free";
                /* Translators: Lyrics scroll choice: after scrolling by hand, the lyrics stay where you left them until you press Back to Current Line. */
                label: _("Stay Put");
              }
            }

            Label {
              /* Translators: Heading of the lyrics timing part of the lyrics options popover. */
              label: _("Lyrics Timing");
              margin-top: 6;
              xalign: 0.0;

              styles [
                "heading",
              ]
            }

            Label {
              /* Translators: Explanation in the lyrics timing popover. */
              label: _("If the lyrics run ahead of or behind the song, nudge them here.");
              xalign: 0.0;
              wrap: true;
              max-width-chars: 28;

              styles [
                "dim-label",
                "caption",
              ]
            }

            Box {
              spacing: 4;
              halign: center;

              styles [
                "lyric-sync-stepper",
              ]

              Button offset_minus_button {
                label: "−100 ms";
                tooltip-text: _("Delay lyrics (-100 ms)");

                styles [
                  "flat",
                ]
              }

              Button offset_reset_button {
                label: "0 ms";
                tooltip-text: _("Reset lyrics sync offset");

                styles [
                  "flat",
                  "lyric-sync-offset",
                ]
              }

              Button offset_plus_button {
                label: "+100 ms";
                tooltip-text: _("Advance lyrics (+100 ms)");

                styles [
                  "flat",
                ]
              }
            }
          };
        };
      }

      Button reload_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Reload lyrics");

        styles [
          "flat",
          "circular",
        ]
      }

      Button fullscreen_button {
        icon-name: "view-fullscreen-symbolic";
        /* Translators: Tooltip of the button in the lyrics that shows them full screen. */
        tooltip-text: _("Full-Screen Lyrics");
        action-name: "win.fullscreen-lyrics";

        styles [
          "flat",
          "circular",
        ]
      }
    }
  };
}
