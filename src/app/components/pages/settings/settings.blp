using Gtk 4.0;
using Adw 1;

template $SettingsWindow : Adw.PreferencesDialog {
  search-enabled: true;

  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "preferences-other-symbolic";

    Adw.PreferencesGroup {
      /* Translators: Header for a group of preference items regarding the application's appearance */

      title: _("Appearance");

      Adw.ComboRow language {
        /* Translators: Title for the interface language preference in settings */
        title: _("Language");
        /* Translators: Subtitle explaining when a language change applies */
        subtitle: _("Requires restarting the app to take effect");
        model: StringList {
          strings [
            _("Follow System"),
            "English",
            "Português (Brasil)"
          ]
        };
      }

      Adw.ComboRow app_theme {
        /* Translators: Title for the live color theme selector in settings */
        title: _("Color Theme");
        /* Translators: Subtitle for the color theme selector. "Follow System" is its first option. */
        subtitle: _("Follow System uses Omarchy, matugen, pywal, wallust, or your desktop theme live");
        model: StringList {
          strings [
            /* Translators: Color theme option: follows Omarchy, matugen/pywal/wallust, or the native desktop theme live. */
            _("Follow System"),
            _("Neutral (Adwaita)"),
            /* Translators: Color theme option, a dark theme with green accents. */
            _("Green"),
            _("OLED Dark"),
            _("Warm Vinyl"),
            _("Purple Night")
          ]
        };
      }

      Adw.ComboRow theme {
        /* Translators: Title for light/dark appearance mode when using the Neutral theme */

        title: _("Light/Dark Mode");
        model: StringList {
          strings [
            _("Light"),
            _("Dark"),
            _("System")
          ]
        };
      }

      Adw.SwitchRow adaptive_cover_colors {
        /* Translators: Title for adaptive album cover tinting preference */
        title: _("Adaptive Cover Colors");
        /* Translators: Description for adaptive album cover tinting */
        subtitle: _("Subtle background tint from the playing album cover");
      }

      Adw.SwitchRow adaptive_cover_accent {
        /* Translators: Title for applying the playing album cover color to UI buttons and highlights */
        title: _("Cover Accent on Controls");
        /* Translators: Description for applying the playing album cover color to UI buttons and highlights */
        subtitle: _("Use the playing album cover's color for buttons, sliders, and highlights");
        sensitive: bind adaptive_cover_colors.active;
      }

      Adw.SwitchRow queue_side_panel_switch {
        /* Translators: Title for an item in preferences */

        title: _("Queue Side Panel");

        /* Translators: Description for the queue side panel preference */

        subtitle: _("Show the queue in a panel at the side of the window");
      }
    }

    Adw.PreferencesGroup {
      /* Translators: Header for a group of preference items regarding playback and window behavior */

      title: _("Playback");

      Adw.ComboRow close_behavior {
        /* Translators: Title for an item in preferences */

        title: _("Close Window Behavior");

        /* Translators: Description for the close window behavior preference */

        subtitle: _("Canto's behavior when closing the main window");
        model: StringList {
          strings [
            _("Ask"),
            _("Run in Background"),
            _("Quit")
          ]
        };
      }

      Adw.SwitchRow inhibit_suspend_switch {
        /* Translators: Title for the keep device awake toggle in preferences */

        title: _("Keep Device Awake While Playing");

        /* Translators: Description for the keep device awake toggle */

        subtitle: _("Prevent the system from automatically suspending while audio is playing");
      }

      Adw.SwitchRow skip_explicit_switch {
        /* Translators: Title for the skip explicit tracks toggle in preferences */

        title: _("Skip Explicit Tracks");

        /* Translators: Description for the skip explicit tracks toggle */

        subtitle: _("Automatically skip tracks marked as explicit");
      }

      Adw.SwitchRow smart_queue_continuation_switch {
        /* Translators: Title for automatic track radio continuation toggle */
        title: _("Smart Queue Continuation");
        /* Translators: Description for automatic track radio continuation */
        subtitle: _("Continue playing similar tracks automatically when your queue finishes");
      }

      Adw.SpinRow shuffle_separation {
        /* Translators: Title for the shuffle separation preference */

        title: _("Shuffle Separation");

        // The subtitle is set from the code: it includes the value
        adjustment: Adjustment {
          lower: 1;
          upper: 10;
          value: 2;
          step-increment: 1;
          page-increment: 1;
        };
      }

      Adw.SpinRow lyrics_offset_ms {
        /* Translators: Title for the manual synced lyrics offset preference */
        title: _("Lyrics Sync Offset (ms)");
        /* Translators: Description explaining positive vs negative lyrics offset */
        subtitle: _("Positive advances lyrics earlier; negative delays them");
        adjustment: Adjustment {
          lower: -10000;
          upper: 10000;
          step-increment: 50;
          page-increment: 250;
        };
      }
    }

    Adw.PreferencesGroup caching_group {
      /* Translators: Header for a group of preference items regarding data caching */

      title: _("Caching");

      /* Translators: Description under the Caching preferences header */

      description: _("Control how Canto caches data locally.");

      Adw.SpinRow memory_cache_size {
        /* Translators: Title for the in-memory cache size preference */

        title: _("Memory Cache Size (MB)");

        /* Translators: Description for the in-memory cache size preference */

        subtitle: _("Maximum memory allocated for caching data while Canto is running.");
        adjustment: Adjustment {
          lower: 1;
          upper: 1024;
          value: 32;
          step-increment: 8;
          page-increment: 32;
        };
      }

      Adw.SpinRow disk_cache_size {
        /* Translators: Title for the on-disk image cache size preference */

        title: _("Disk Cache Size (MB)");

        /* Translators: Description for the on-disk image cache size preference */

        subtitle: _("Maximum disk space allocated for caching data between sessions.");
        adjustment: Adjustment {
          lower: 16;
          upper: 4096;
          value: 256;
          step-increment: 16;
          page-increment: 64;
        };
      }

      Adw.SpinRow audio_cache_size {
        /* Translators: Title for the disk audio cache size preference */

        title: _("Audio Cache Size (MB)");

        /* Translators: Description for the disk audio cache size preference */

        subtitle: _("Maximum disk space allocated for caching downloaded audio.");
        adjustment: Adjustment {
          lower: 64;
          upper: 16384;
          value: 1024;
          step-increment: 64;
          page-increment: 256;
        };
      }

      Adw.ActionRow clear_cache_row {
        /* Translators: Title for the clear cache action row */

        title: _("Clear Cache");

        /* Translators: Description for the clear cache action row */

        subtitle: _("Remove all cached data and images stored on disk");

        Button clear_cache_button {
          /* Translators: Label for the button that clears the cache */

          label: _("Clear");
          valign: center;

          styles [
            "destructive-action",
          ]
        }
      }
    }
  }

  Adw.PreferencesPage audio_page {
    name: "audio";
    /* Translators: Title of the Audio page in Preferences. */
    title: _("Audio");
    icon-name: "audio-speakers-symbolic";

    Adw.PreferencesGroup audio_group {
      /* Translators: Header for a group of preference items regarding audio */

      title: _("Audio");

      Adw.ComboRow audio_backend {
        /* Translators: Title for an item in preferences */

        title: _("Audio Backend");
        model: StringList {
          strings [
            "PulseAudio",
            "ALSA"
          ]
        };
      }

      Adw.ActionRow alsa_device_row {
        /* Translators: Title for an item in preferences */

        title: _("ALSA Device");

        /* Translators: Description for the item (ALSA Device) in preferences */

        subtitle: _("Applied only if audio backend is ALSA");

        Entry alsa_device {
          valign: center;
        }
      }

      Adw.ComboRow player_bitrate {
        /* Translators: Title for an item in preferences */

        title: _("Audio Quality");
        subtitle: _("Streaming bitrate from Spotify (higher uses more bandwidth)");
        model: StringList {
          strings [
            _("Normal"),
            _("High"),
            _("Very High"),
            _("Lossless"),
          ]
        };
      }

      Adw.ComboRow audio_format {
        title: _("Audio Format");
        subtitle: _("Sample bit depth for audio output");
        model: StringList {
          strings [
            "S16 (16-bit)",
            "S24 (24-bit)",
            "S24_3 (24-bit packed)",
            "S32 (32-bit)",
            "F32 (32-bit float)",
            "F64 (64-bit float)",
          ]
        };
      }

      Adw.SwitchRow gapless_playback {
        /* Translators: Title for an item in preferences */

        title: _("Gapless Playback");
        subtitle: _("Eliminates silence between consecutive tracks");
      }

      Adw.SpinRow crossfade_seconds {
        /* Translators: Title for the crossfade duration preference */
        title: _("Crossfade (seconds)");
        /* Translators: Subtitle for the crossfade duration preference */
        subtitle: _("Blend smoothly between consecutive tracks (0 disables)");
        adjustment: Adjustment {
          lower: 0;
          upper: 12;
          value: 0;
          step-increment: 1;
          page-increment: 2;
        };
      }

      Adw.ComboRow volume_curve {
        title: _("Volume Curve");
        subtitle: _("Controls how the volume slider responds");
        model: StringList {
          strings [
            _("Logarithmic"),
            _("Linear"),
            _("Cubic"),
          ]
        };
      }

      Adw.SwitchRow mono_audio_switch {
        title: _("Mono Audio");
        subtitle: _("Mix left and right channels together so both speakers play the same audio");
      }

    }

    Adw.PreferencesGroup normalisation_group {
      title: _("Normalisation");
      description: _("Adjust volume levels between tracks for consistent loudness");

      Adw.SwitchRow normalisation_switch {
        title: _("Enable Normalisation");
        subtitle: _("Automatically adjust volume between tracks");
      }

      Adw.ComboRow normalisation_type {
        title: _("Normalisation Type");
        subtitle: _("How gain values are selected");
        sensitive: bind normalisation_switch.active;
        model: StringList {
          strings [
            _("Auto"),
            _("Track"),
            _("Album"),
          ]
        };
      }

      Adw.ComboRow normalisation_method {
        title: _("Normalisation Method");
        subtitle: _("Basic clips peaks, Dynamic uses a limiter");
        sensitive: bind normalisation_switch.active;
        model: StringList {
          strings [
            _("Dynamic"),
            _("Basic"),
          ]
        };
      }

      Adw.SpinRow normalisation_pregain {
        title: _("Pre-gain (dB)");
        subtitle: _("Additional gain applied before normalisation");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: -10.0;
          upper: 10.0;
          value: 0.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
      }

      Adw.SpinRow normalisation_threshold {
        title: _("Threshold (dBFS)");
        subtitle: _("Ceiling for dynamic normalisation");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: -10.0;
          upper: 0.0;
          value: -2.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
      }

      Adw.SpinRow normalisation_attack {
        title: _("Attack (ms)");
        subtitle: _("How quickly the limiter reacts to peaks");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: 1.0;
          upper: 500.0;
          value: 5.0;
          step-increment: 1.0;
          page-increment: 10.0;
        };
      }

      Adw.SpinRow normalisation_release {
        title: _("Release (ms)");
        subtitle: _("How quickly the limiter recovers after peaks");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: 1.0;
          upper: 1000.0;
          value: 100.0;
          step-increment: 5.0;
          page-increment: 50.0;
        };
      }

      Adw.SpinRow normalisation_knee {
        title: _("Knee (dB)");
        subtitle: _("Width of the soft knee for the limiter");
        sensitive: bind normalisation_switch.active;
        adjustment: Adjustment {
          lower: 0.0;
          upper: 10.0;
          value: 5.0;
          step-increment: 0.5;
          page-increment: 1.0;
        };
      }
    }

    $EqualizerWidget equalizer {}

    $PanWidget pan {}

    $PitchWidget pitch {}

    Adw.PreferencesGroup network_group {
      /* Translators: Header for a group of preference items regarding network */

      title: _("Network");

      Adw.ActionRow {
        /* Translators: Title for an item in preferences */

        title: _("Access Point Port");

        /* Translators: Longer description for an item (Access Point Port) in preferences */

        subtitle: _("Port used for connections to Spotify’s Access Point. Set to 0 if any port is fine.");

        Entry ap_port {
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup soloist_group {
      title: _("Spotify Soloist");
      description: _("Spotify's official player for Linux, with no window. Canto plays through it when this account can't play inside Canto. It needs a free developer key from Spotify.");

      header-suffix: Button soloist_guide_button {
        label: _("How to get a key");
        valign: center;

        styles [
          "flat",
        ]
      };

      Adw.SwitchRow soloist_enabled_switch {
        title: _("Play Through Soloist");
        subtitle: _("When off, or without a key, Canto uses the Spotify app hidden in the background");
      }

      Adw.PasswordEntryRow soloist_key_entry {
        title: _("Soloist API Key");
        show-apply-button: true;
      }

      Adw.ActionRow soloist_status_row {
        title: _("Status");
        subtitle: _("Checking…");
        subtitle-selectable: true;
      }

      Adw.ActionRow soloist_quality_row {
        title: _("Audio Quality");
        subtitle: _("Spotify picks it. To change it, open Spotify on your phone, tap “Canto” in the device list and choose the quality.");
      }
    }
  }

  Adw.PreferencesPage integrations_page {
    name: "integrations";
    title: _("Integrations");
    icon-name: "view-app-grid-symbolic";

    Adw.PreferencesGroup {
      title: _("Genius (Credits and Liner Notes)");
      description: _("Optional Client Access Token to show producers, writers and featured artists in the Now Playing panel.");

      header-suffix: Button genius_guide_button {
        label: _("How to get token");
        valign: center;

        styles [
          "flat",
        ]
      };

      Adw.PasswordEntryRow genius_token_entry {
        title: _("Client Access Token");
      }
    }

    // Its own group: the Genius one above is about the token for credits,
    // and this works without a token
    Adw.PreferencesGroup {
      title: _("Lyrics");

      Adw.SwitchRow genius_lyrics_switch {
        /* Translators: Switch in Preferences > Integrations > Lyrics: when LRCLIB (the synced lyrics site) has no lyrics for a song, Canto shows Genius's. */
        title: _("Lyrics When LRCLIB Has None");
        /* Translators: Subtitle of the "Lyrics When LRCLIB Has None" switch. Genius lyrics have no timing: they don't follow the song. */
        subtitle: _("Shows the lyrics from Genius, without timing");
      }
    }

    Adw.PreferencesGroup {
      title: _("Lyrics Translation");
      description: _("Lyrics are translated through Google Translate for free, without a key. That free route isn't official and may stop working; a Google Cloud API key (500,000 characters a month free, a billing account required) makes it reliable.");

      Adw.PasswordEntryRow google_translate_key_entry {
        title: _("Google Cloud API Key (optional)");
      }
    }

    Adw.PreferencesGroup {
      title: _("Scrobbling (Last.fm and ListenBrainz)");
      description: _("Track played songs to Last.fm and/or ListenBrainz with automatic offline retry.");

      header-suffix: Button scrobbling_guide_button {
        label: _("How to set up scrobbling");
        valign: center;

        styles [
          "flat",
        ]
      };

      Adw.SwitchRow scrobble_enabled_switch {
        title: _("Enable Scrobbling");
        subtitle: _("Send Now Playing updates and scrobble tracks after listening");
      }

      Adw.SwitchRow scrobble_respect_remote_switch {
        title: _("Scrobble Connect Devices");
        subtitle: _("Also track plays from active Spotify Connect speakers and phones");
      }

      Adw.PasswordEntryRow lastfm_api_key_entry {
        title: _("Last.fm API Key");
      }

      Adw.PasswordEntryRow lastfm_api_secret_entry {
        title: _("Last.fm API Secret");
      }

      Adw.ActionRow lastfm_auth_row {
        title: _("Authorize Last.fm");
        subtitle: _("Enter API Key and Secret above, then connect your account");

        Box {
          orientation: horizontal;
          spacing: 6;
          valign: center;

          Button lastfm_step1_btn {
            label: _("1. Open Auth");
          }

          Button lastfm_step2_btn {
            label: _("2. Complete");
            sensitive: false;
          }

          Button lastfm_disconnect_btn {
            label: _("Disconnect");
            visible: false;

            styles [
              "destructive-action",
            ]
          }
        }
      }

      Adw.SwitchRow lastfm_love_switch {
        /* Translators: Switch in Preferences > Integrations, shown once Last.fm is connected. "Love" is Last.fm's heart on a song. */
        title: _("Love on Last.fm When You Like a Song");
        /* Translators: Subtitle of the "Love on Last.fm When You Like a Song" switch. */
        subtitle: _("Removing a song from your liked songs unloves it too");
        visible: false;
      }

      Adw.PasswordEntryRow listenbrainz_token_entry {
        title: _("ListenBrainz User Token");
      }
    }

    Adw.PreferencesGroup {
      title: _("Visual Bridge");
      description: _("Opt-in lightweight local state and audio RMS/peak output for status bars, widgets, and external visualizers.");

      Adw.SwitchRow visual_bridge_switch {
        title: _("Enable Visual Bridge");
        subtitle: _("Write active track, synced lyric, theme colors, and audio levels to $XDG_RUNTIME_DIR/canto/state.json");
      }
    }
  }
}
