using Gtk 4.0;
using Adw 1;


template $LoginWindow : Adw.Window {
  title: "Canto";
  default-width: 360;
  default-height: 100;

  styles ["login-window"]

  Box {
    hexpand: true;
    margin-bottom: 24;
    orientation: vertical;

    Adw.HeaderBar {
      [title]
      Label {}

      styles ["flat"]
    }

    WindowHandle {

      Adw.Clamp {
        maximum-size: 360;
        tightening-threshold: 280;

        Box {
          hexpand: true;
          orientation: vertical;
          margin-start: 16;
          margin-end: 16;
          spacing: 24;

          Image {
            icon-name: "io.github.gusthanks.Canto";
            pixel-size: 128;
            margin-bottom: 12;
          }

          Box {
            hexpand: true;
            orientation: vertical;
            spacing: 4;

            Label {
              label: _("Welcome to Canto");
              halign: center;
              styles ["title-1"]
            }

            Label {
              /* Translators: Login window subtitle */
              label: _("Log in with your Spotify Account");
              wrap: true;
              wrap-mode: word;
              halign: center;
              justify: center;
              styles ["body"]
            }
          }

          /* Status area: shows either the premium notice or an auth error, never both */
          Stack status_stack {
            transition-type: crossfade;
            transition-duration: 200;

            StackPage {
              name: "notice";
              child: Box {
                orientation: horizontal;
                halign: center;
                spacing: 8;

                Image {
                  icon-name: "dialog-warning-symbolic";
                  pixel-size: 16;
                  valign: center;
                  styles ["warning"]
                }

                Label {
                  /* Translators: Premium requirement notice shown on the login page. */
                  label: _("A Spotify Premium subscription is required.");
                  styles ["caption", "warning"]
                }
              };
            }

            StackPage {
              name: "error";
              child: Box {
                orientation: horizontal;
                halign: center;
                spacing: 8;

                Image {
                  icon-name: "dialog-warning-symbolic";
                  pixel-size: 16;
                  valign: center;
                  styles ["error"]
                }

                Label {
                  /* Translators: This error is shown when a non-premium account is detected. */
                  label: _("Your account does not have a Spotify Premium subscription.");
                  styles ["caption", "error"]
                }
              };
            }

            StackPage {
              name: "login_error";
              child: Box {
                orientation: horizontal;
                halign: center;
                spacing: 8;

                Image {
                  icon-name: "dialog-error-symbolic";
                  pixel-size: 16;
                  valign: center;
                  styles ["error"]
                }

                Label {
                  /* Translators: This error is shown when login fails. Browser extensions such as ad or privacy blockers can break the login page. */
                  label: _("Login failed. Please check your connection and browser extensions before trying again.");
                  wrap: true;
                  wrap-mode: word_char;
                  styles ["caption", "error"]
                }
              };
            }
          }

          Button login_with_spotify_button {
            /* Translators: Log in button label */
            label: _("Log in with Spotify…");
            halign: center;
            styles ["pill", "suggested-action"]
          }

          Box {
            orientation: vertical;
            spacing: 10;

            Button use_local_folder_button {
              /* Translators: Login screen option to browse and play a local music folder without Spotify. */
              label: _("Use Local Music Folder…");
              halign: center;
              styles ["pill"]
            }

            ToggleButton connect_subsonic_toggle {
              /* Translators: Login screen toggle revealing fields to connect to a Navidrome or OpenSubsonic server. */
              label: _("Connect Navidrome / Subsonic…");
              halign: center;
              styles ["flat", "caption"]
            }

            Revealer subsonic_revealer {
              reveal-child: bind connect_subsonic_toggle.active;
              transition-type: slide_down;

              child: Box {
                orientation: vertical;
                spacing: 8;

                ListBox {
                  selection-mode: none;
                  styles ["boxed-list"]

                  Adw.EntryRow subsonic_url_entry {
                    /* Translators: Server URL field on Login screen for Navidrome / Subsonic. */
                    title: _("Server URL");
                  }

                  Adw.EntryRow subsonic_user_entry {
                    /* Translators: Username field on Login screen for Navidrome / Subsonic. */
                    title: _("Username");
                  }

                  Adw.PasswordEntryRow subsonic_pass_entry {
                    /* Translators: Password field on Login screen for Navidrome / Subsonic. */
                    title: _("Password");
                  }
                }

                Box {
                  orientation: horizontal;
                  spacing: 8;

                  Label subsonic_status_label {
                    hexpand: true;
                    xalign: 0;
                    wrap: true;
                    wrap-mode: word_char;
                    styles ["caption", "dim-label"]
                  }

                  Button subsonic_connect_button {
                    /* Translators: Connect button for Navidrome / Subsonic server on Login screen. */
                    label: _("Connect");
                    halign: end;
                    styles ["pill", "suggested-action"]
                  }
                }
              };
            }
          }

          Box {
            orientation: vertical;
            spacing: 12;

            ToggleButton custom_client_id_toggle {
              /* Translators: Discreet advanced toggle on the login window that reveals an optional field for using a personal Spotify Developer Client ID. */
              label: _("Use my own Client ID");
              halign: center;
              styles ["flat", "caption"]
            }

            Revealer custom_client_id_revealer {
              reveal-child: bind custom_client_id_toggle.active;
              transition-type: slide_down;

              child: Box {
                orientation: vertical;
                spacing: 8;

                ListBox {
                  selection-mode: none;
                  styles ["boxed-list"]

                  Adw.EntryRow custom_client_id_entry {
                    /* Translators: Title of the optional custom Spotify Client ID entry on the login window. */
                    title: _("Spotify Client ID");
                  }

                  Adw.ActionRow redirect_uri_row {
                    /* Translators: Title of the row showing the OAuth Redirect URI to register in a personal Spotify Developer app. */
                    title: _("Redirect URI");
                    subtitle: "http://127.0.0.1:8898/login";
                    activatable-widget: copy_redirect_uri_button;

                    Button copy_redirect_uri_button {
                      icon-name: "edit-copy-symbolic";
                      valign: center;
                      /* Translators: Tooltip of the button copying the OAuth Redirect URI. */
                      tooltip-text: _("Copy");
                      styles ["flat"]
                    }
                  }
                }

                Label custom_client_id_hint {
                  /* Translators: Hint under the optional custom Spotify Client ID field on the login window. */
                  label: _("Optional. Leave empty to use Canto’s built-in Client ID.");
                  wrap: true;
                  wrap-mode: word_char;
                  halign: start;
                  xalign: 0;
                  styles ["caption", "dim-label"]
                }
              };
            }
          }
        }
      }
    }
  }
}
