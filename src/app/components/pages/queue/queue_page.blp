using Gtk 4.0;
using Adw 1;

template $QueuePageWidget : Adw.Bin {
  child: Box {
    orientation: vertical;

    CenterBox selection_bar {
      visible: false;

      styles [
        "toolbar",
        "queue-page__selection-bar",
      ]

      [start]
      Button selection_cancel {
        /* Translators: Button label. Exits selection mode. */
        label: _("Cancel");
      }

      [center]
      Label selection_count {
        ellipsize: end;

        styles [
          "heading",
        ]
      }

      [end]
      Button select_all {
        /* Translators: Button label. Selects all visible songs. */
        label: _("Select All");
      }
    }

    // The songs played lately, folded above the queue
    Box recent_section {
      orientation: vertical;

      styles [
        "queue-page__recent",
      ]

      Box recent_header {
        orientation: horizontal;
        spacing: 2;

        styles [
          "queue-page__recent-header",
        ]

        Button recent_toggle {
          hexpand: true;
          focus-on-click: false;

          styles [
            "flat",
            "queue-page__recent-toggle",
          ]

          child: Label {
            /* Translators: Header above the queue in the side panel; clicking it shows or hides the songs played lately. */
            label: _("Recently Played");
            xalign: 0;
            hexpand: true;
            ellipsize: end;

            styles [
              "heading",
            ]
          };
        }

        Button save_playlist_button {
          visible: false;
          focus-on-click: false;
          valign: center;
          icon-name: "list-add-symbolic";
          /* Translators: Tooltip on the compact "+" icon button on the queue page that saves the current play queue into a new playlist. */
          tooltip-text: _("Save Queue as Playlist");

          styles [
            "flat",
            "circular",
            "queue-page__save-playlist",
          ]
        }

        Button recent_chevron_button {
          focus-on-click: false;
          valign: center;
          tooltip-text: _("Recently Played");

          styles [
            "flat",
            "circular",
            "queue-page__recent-chevron",
          ]

          child: Image recent_chevron {
            icon-name: "pan-end-symbolic";
          };
        }
      }

      Revealer recent_revealer {
        transition-type: slide_down;

        child: Stack recent_stack {
          vhomogeneous: false;
          hhomogeneous: false;

          StackPage {
            name: "loading";

            child: Adw.Spinner {
              height-request: 32;
              margin-top: 8;
              margin-bottom: 8;
            };
          }

          StackPage {
            name: "list";

            child: ScrolledWindow recent_scroller {
              hscrollbar-policy: never;
              propagate-natural-height: true;
              // Three songs; widget.rs sets it from the rows' real height
              max-content-height: 150;

              child: ListBox recent_list {
                selection-mode: none;

                styles [
                  "navigation-sidebar",
                  "queue-page__recent-list",
                ]
              };
            };
          }

          StackPage {
            name: "status";

            child: Label recent_status {
              wrap: true;
              justify: center;
              margin-top: 8;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              styles [
                "dim-label",
              ]
            };
          }
        };
      }

      Separator {
        styles [
          "queue-page__recent-separator",
        ]
      }
    }

    Stack queue_stack {
      vexpand: true;

      styles [
        "queue-page__content",
      ]

      StackPage {
        name: "list";

        child: ScrolledWindow queue_scroller {
          hscrollbar-policy: never;
          vexpand: true;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "canto-queue-symbolic";
          /* Translators: Shown in place of the queue when nothing plays or is queued. */
          title: _("Nothing Queued");

          styles [
            "compact",
          ]
        };
      }
    }
  };
}
