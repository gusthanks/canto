using Gtk 4.0;
using Adw 1;

template $UtilityPanelWidget : Adw.Bin {
  // Floating over the page it is a rounded card of its own (app.css):
  // what is inside is cut at its corners
  overflow: hidden;

  child: Box {
    orientation: horizontal;

    // The drag itself is on the split view (see shell/layout)
    Box resize_handle {
      width-request: 6;

      styles [
        "utility-panel__resize-handle",
      ]
    }


    Box {
      orientation: vertical;
      hexpand: true;

      Adw.HeaderBar header {
        show-start-title-buttons: false;
        // The window's buttons are in its top bar
        show-end-title-buttons: false;

        styles [
          "flat",
          "utility-panel__header",
        ]

        title-widget: Box switcher_box {
          orientation: horizontal;
          halign: center;
          valign: center;

          styles [
            "linked",
            "utility-panel__tabs",
          ]

          ToggleButton now_tab {
            /* Translators: Tab label for the current track in utility panel. */
            tooltip-text: _("Now Playing");
            active: true;

            // Bars that move while music plays, still while paused
            child: Box now_indicator {
              halign: center;
              valign: center;

              styles [
                "playback-indicator",
                "utility-panel__now-indicator",
                "utility-panel__now-indicator--idle",
              ]
            };
          }

          ToggleButton lyrics_tab {
            /* Translators: Tab label for lyrics in utility panel. */
            tooltip-text: _("Lyrics");
            icon-name: "canto-lyrics-symbolic";
            group: now_tab;
          }

          ToggleButton queue_tab {
            /* Translators: Tab label for the queue in utility panel. */
            tooltip-text: _("Queue");
            icon-name: "canto-queue-symbolic";
            group: now_tab;
          }

          ToggleButton about_tab {
            /* Translators: Tab label for what Genius knows about the current song (credits, bio, artist) in utility panel. */
            tooltip-text: _("About");
            icon-name: "canto-genius-symbolic";
            group: now_tab;
          }

          ToggleButton stats_tab {
            /* Translators: Tab label for the current song's Last.fm numbers (plays, listeners, tags) in utility panel. */
            tooltip-text: _("Stats");
            icon-name: "canto-stats-symbolic";
            group: now_tab;
          }
        };

        [end]
        Button close_panel {
          icon-name: "pan-end-symbolic";
          /* Translators: Tooltip of the button that hides the right side panel (Now Playing, Queue, Lyrics). */
          tooltip-text: _("Hide Side Panel");
          action-name: "win.utility-panel";
          valign: center;
          focus-on-click: false;

          styles [
            "flat",
          ]
        }
      }

      Adw.HeaderBar selection_header {
        show-start-title-buttons: false;
        show-end-title-buttons: false;
        visible: false;

        styles [
          "flat",
          "selection-mode",
          "utility-panel__header",
        ]

        title-widget: Adw.WindowTitle selection_title {};

        [start]
        Button selection_cancel {
          valign: center;

          /* Translators: Button label. Exits selection mode. */
          label: _("Cancel");
        }

        [end]
        Button select_all {
          valign: center;

          /* Translators: Button label. Selects all visible songs. */
          label: _("Select All");
        }
      }

      Stack panel_stack {
        vexpand: true;
        transition-type: crossfade;

        StackPage {
          name: "now";

          child: Adw.Bin now_content {
            vexpand: true;
          };
        }

        StackPage {
          name: "queue";

          child: Adw.Bin queue_content {
            vexpand: true;
          };
        }

        StackPage {
          name: "lyrics";

          child: Adw.Bin lyrics_content {
            vexpand: true;
          };
        }

        StackPage {
          name: "about";

          child: Adw.Bin about_content {
            vexpand: true;
          };
        }

        StackPage {
          name: "stats";

          child: Adw.Bin stats_content {
            vexpand: true;
          };
        }
      }
    }
  };
}
