using Gtk 4.0;
using Adw 1;

template $UtilityPanelWidget : Adw.Bin {
  child: Box {
    orientation: horizontal;

    // The drag itself is on the split view (see shell/layout)
    Box resize_handle {
      width-request: 6;

      styles [
        "utility-panel__resize-handle",
      ]
    }


    Box {
      orientation: vertical;
      hexpand: true;

      Adw.HeaderBar header {
        show-start-title-buttons: false;

        styles [
          "flat",
          "utility-panel__header",
        ]

        title-widget: Box switcher_box {
          orientation: horizontal;
          halign: center;
          valign: center;

          styles [
            "linked",
          ]

          ToggleButton queue_tab {
            /* Translators: Tab label for the queue in utility panel. */
            label: _("Queue");
            active: true;
          }

          ToggleButton lyrics_tab {
            /* Translators: Tab label for lyrics in utility panel. */
            label: _("Lyrics");
            group: queue_tab;
          }
        };
      }

      Adw.HeaderBar selection_header {
        show-start-title-buttons: false;
        show-end-title-buttons: false;
        visible: false;

        styles [
          "flat",
          "selection-mode",
          "utility-panel__header",
        ]

        title-widget: Adw.WindowTitle selection_title {};

        [start]
        Button selection_cancel {
          valign: center;

          /* Translators: Button label. Exits selection mode. */
          label: _("Cancel");
        }

        [end]
        Button select_all {
          valign: center;

          /* Translators: Button label. Selects all visible songs. */
          label: _("Select All");
        }
      }

      Stack panel_stack {
        vexpand: true;

        StackPage {
          name: "queue";

          child: Adw.Bin queue_content {
            vexpand: true;
          };
        }

        StackPage {
          name: "lyrics";

          child: Adw.Bin lyrics_content {
            vexpand: true;
          };
        }
      }
    }
  };
}
