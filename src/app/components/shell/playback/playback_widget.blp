using Gtk 4.0;
using Adw 1;

template $PlaybackWidget : Box {
  orientation: vertical;

  styles [
    "playback-bar",
  ]

  Adw.BreakpointBin {
    width-request: 1;
    height-request: 88;

    Adw.Breakpoint {
      condition("max-width:700sp")

      setters {
        volume_box.visible: false;
        volume_button.visible: true;
        device_selector_box.visible: false;
        mini_player_button.visible: false;
        playback_center.homogeneous: false;
      }
    }

    Adw.Breakpoint {
      condition("max-width:480sp")

      setters {
        volume_box.visible: false;
        volume_button.visible: true;
        device_selector_box.visible: false;
        eq_button.visible: false;
        playback_center.homogeneous: false;
        now_playing_box.visible: false;
        now_playing_button_box.visible: true;
        lyrics_button.visible: false;
        mini_player_button.visible: false;
        queue_button.visible: false;
        sleep_timer_button.visible: false;
        playback_center.margin-start: 10;
        playback_center.margin-end: 10;
      }
    }

    child: Box playback_center {
      orientation: horizontal;
      homogeneous: false;
      halign: fill;
      hexpand: true;
      height-request: 66;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;
      spacing: 8;

      Box now_playing_start {
        hexpand: false;
        halign: start;
        valign: center;

        Box now_playing_button_box {
          visible: false;
          width-request: 40;
          valign: center;

          Button now_playing_button {
            visible: false;
            icon-name: "now-playing-symbolic";
            tooltip-text: _("Now Playing");
            action-name: "win.show-now-playing";
            focus-on-click: false;
            can-focus: false;
            valign: center;

            styles [
              "flat",
            ]
          }
        }

        Box now_playing_box {
          hexpand: true;
          height-request: 54;
          overflow: hidden;
          halign: start;

          $PlaybackInfoWidget now_playing {
            halign: start;
            valign: center;
          }
        }
      }

      Box {
        orientation: vertical;
        valign: center;
        hexpand: true;
        spacing: 2;

        $PlaybackControlsWidget controls {
          hexpand: false;
          halign: center;
          valign: center;
        }

        Box seek_row {
          orientation: horizontal;
          valign: center;
          spacing: 8;
          hexpand: true;

          Label track_position {
            label: "0∶00";
            width-chars: 5;
            xalign: 1.0;

            styles [
              "numeric",
              "caption",
              "playback-time",
            ]
          }

          Scale seek_bar {
            hexpand: true;
            show-fill-level: true;
            restrict-to-fill-level: false;
            fill-level: 0;
            digits: 0;
            draw-value: false;

            styles [
              "seek-bar",
            ]
          }

          Label track_duration {
            label: "0∶00";
            width-chars: 5;
            xalign: 0.0;

            styles [
              "numeric",
              "caption",
              "playback-time",
            ]
          }
        }
      }

      Box bar_end {
        hexpand: false;
        halign: end;
        valign: center;
        spacing: 2;

        // User can hide this from the bar (player-bar-* settings)
        Box lyrics_slot {
          Button lyrics_button {
            width-request: 36;
            height-request: 36;
            icon-name: "canto-lyrics-symbolic";
            /* Translators: Tooltip of the player bar button that shows or hides synced lyrics. */
            tooltip-text: _("Lyrics");
            action-name: "win.show-lyrics";
            valign: center;
            focus-on-click: false;
            can-focus: false;

            styles [
              "flat",
              "circular",
            ]
          }
        }

        // User can hide this from the bar (player-bar-* settings)
        Box queue_slot {
          Button queue_button {
            width-request: 36;
            height-request: 36;
            icon-name: "canto-queue-symbolic";
            /* Translators: Tooltip of the playback bar button that shows or hides the queue. */
            tooltip-text: _("Queue");
            action-name: "win.show-queue";
            valign: center;
            focus-on-click: false;
            can-focus: false;

            styles [
              "flat",
              "circular",
            ]
          }
        }

        MenuButton sleep_timer_button {
          // Only shows while a timer runs (the countdown); set from More Options
          visible: false;
          width-request: 36;
          height-request: 36;
          tooltip-text: _("Sleep Timer");
          valign: center;
          direction: up;
          focus-on-click: false;
          can-focus: false;

          styles [
            "flat",
            "circular",
          ]

          child: Box {
            orientation: horizontal;
            spacing: 4;
            halign: center;
            valign: center;

            Image {
              icon-name: "alarm-symbolic";
            }

            Label sleep_timer_label {
              visible: false;

              styles [
                "sleep-timer-countdown",
              ]
            }
          };

          popover: Popover sleep_popover {
            child: Box {
              orientation: vertical;
              spacing: 4;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 6;
              margin-end: 6;

              Label {
                label: _("Sleep Timer");
                xalign: 0.0;
                margin-start: 8;
                margin-bottom: 4;

                styles [
                  "caption-heading",
                  "dim-label",
                ]
              }

              Button sleep_off_btn {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Off");
                  xalign: 0.0;
                };
              }

              Button sleep_track_btn {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("End of current track");
                  xalign: 0.0;
                };
              }

              Button sleep_15_btn {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("15 min");
                  xalign: 0.0;
                };
              }

              Button sleep_30_btn {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("30 min");
                  xalign: 0.0;
                };
              }

              Button sleep_45_btn {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("45 min");
                  xalign: 0.0;
                };
              }

              Button sleep_60_btn {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("60 min");
                  xalign: 0.0;
                };
              }
            };
          };
        }

        // User can hide this from the bar (player-bar-* settings)
        Box device_slot {
          Box device_selector_box {
            valign: center;

            $DeviceSelectorWidget device_selector {}
          }
        }

        // User can hide this from the bar (player-bar-* settings)
        Box volume_slot {
          Box volume_box {
            width-request: 132;
            spacing: 2;
            valign: center;

            Button mute_button {
              width-request: 34;
              height-request: 34;
              icon-name: "audio-volume-high-symbolic";
              tooltip-text: _("Mute / Unmute");
              focus-on-click: false;
              can-focus: false;

              styles [
                "flat",
                "circular",
              ]
            }

            Scale volume_slider {
              hexpand: true;
              show-fill-level: true;
              restrict-to-fill-level: false;
              value-pos: left;

              styles [
                "volume-slider",
              ]

              adjustment: Adjustment {
                lower: 0.0;
                value: 0.7;
                upper: 1.0;
                step-increment: 0.01;
                page-increment: 0.05;
              };
            }
          }

          MenuButton volume_button {
            visible: false;
            width-request: 36;
            height-request: 36;
            icon-name: "audio-volume-high-symbolic";
            tooltip-text: _("Volume");
            halign: end;
            valign: center;
            direction: up;
            focus-on-click: false;
            can-focus: false;

            styles [
              "flat",
              "circular",
            ]

            popover: Popover {
              child: Scale {
                inverted: true;
                orientation: vertical;
                height-request: 160;
                adjustment: bind volume_slider.adjustment;
              };
            };
          }
        }

        // User can hide this from the bar (player-bar-* settings)
        Box mini_player_slot {
          Button mini_player_button {
            width-request: 36;
            height-request: 36;
            icon-name: "canto-mini-player-symbolic";
            /* Translators: Tooltip of the player bar button that opens the small player window. */
            tooltip-text: _("Mini Player");
            action-name: "win.mini-player";
            valign: center;
            focus-on-click: false;
            can-focus: false;

            styles [
              "flat",
              "circular",
            ]
          }
        }

        MenuButton eq_button {
          width-request: 36;
          height-request: 36;
          icon-name: "canto-more-symbolic";
          /* Translators: Tooltip of the player bar button that opens the sleep timer, equalizer and audio options. */
          tooltip-text: _("More Options");
          valign: center;
          direction: up;
          focus-on-click: false;
          can-focus: false;

          styles [
            "flat",
            "circular",
          ]

          popover: Popover eq_popover {
            child: Box {
              orientation: vertical;
              spacing: 4;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 6;
              margin-end: 6;

              Button more_sleep_timer {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Box {
                  spacing: 10;

                  Image {
                    icon-name: "alarm-symbolic";
                  }

                  Label {
                    label: _("Sleep Timer");
                    xalign: 0.0;
                    hexpand: true;
                  }

                  Image {
                    icon-name: "pan-end-symbolic";
                  }
                };
              }

              Separator {
                margin-top: 2;
                margin-bottom: 4;
              }

              Label {
                label: _("Equalizer Presets");
                xalign: 0.0;
                margin-start: 8;
                margin-bottom: 4;

                styles [
                  "caption-heading",
                  "dim-label",
                ]
              }

              Button eq_preset_flat {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Flat");
                  xalign: 0.0;
                };
              }

              Button eq_preset_bass {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Bass Boost");
                  xalign: 0.0;
                };
              }

              Button eq_preset_vocal {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Vocal");
                  xalign: 0.0;
                };
              }

              Button eq_preset_lofi {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Lo-Fi");
                  xalign: 0.0;
                };
              }

              Button eq_preset_acoustic {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Acoustic");
                  xalign: 0.0;
                };
              }

              Separator {
                margin-top: 2;
                margin-bottom: 2;
              }

              Button start_radio_button {
                action-name: "win.start-track-radio";
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Start Track Radio");
                  xalign: 0.0;
                };
              }

              Button customize_bar_button {
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  /* Translators: Item in the player bar's More Options menu: choose which buttons the bar shows. */
                  label: _("Customize Bar…");
                  xalign: 0.0;
                };
              }

              Button eq_open_settings {
                action-name: "win.preferences";
                halign: fill;

                styles [
                  "flat",
                  "playback-preset-btn",
                ]

                child: Label {
                  label: _("Audio Settings…");
                  xalign: 0.0;
                };
              }
            };
          };
        }
      }
    };
  }
}
