using Gtk 4.0;

template $NavigationPanelRow : ListBoxRow {
  Box content {
    visible: true;
    spacing: 12;

    // Clips the cover's corners
    Box icon_clip {
      overflow: hidden;
      valign: center;

      Image icon {
      }
    }

    Label title {
      hexpand: true;
      ellipsize: end;
      xalign: 0;
    }
  }
}
