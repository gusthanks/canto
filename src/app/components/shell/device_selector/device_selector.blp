using Gtk 4.0;
using Adw 1;

template $DeviceSelectorWidget : Button {
  width-request: 36;
  height-request: 36;

  styles [
    "flat",
    "circular",
    "device-selector",
  ]

  /* Translators: Tooltip of the player bar's device button before it knows where the sound plays. */
  tooltip-text: _("Choose Where to Play");

  Adw.ButtonContent button_content {
    halign: center;
    hexpand: false;
    icon-name: "audio-x-generic-symbolic";
  }
}

menu menu {
  section {
    label: _("Playing On");

    item {
      custom: "custom_content";
    }
  }

  section {
    item {
      label: _("Refresh Devices");
      action: "devices.refresh";
    }
  }
}

PopoverMenu popover {
}

Box custom_content {
  orientation: vertical;

  CheckButton this_device_button {
    sensitive: true;

    child: Box {
      spacing: 8;

      Image {
        icon-name: "canto-device-computer-symbolic";
      }

      Label {
        label: _("This Device");
      }
    };
  }

  Box devices {
    orientation: vertical;
  }
}
