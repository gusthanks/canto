using Gtk 4.0;
using Adw 1;

template $DeviceSelectorWidget : Button {
  width-request: 36;
  height-request: 36;

  styles [
    "flat",
    "circular",
    "device-selector",
  ]

  /* Translators: Tooltip of the player bar's device button before it knows where the sound plays. */
  tooltip-text: _("Choose Where to Play");

  Adw.ButtonContent button_content {
    halign: center;
    hexpand: false;
    icon-name: "audio-x-generic-symbolic";
  }
}

Popover popover {
  autohide: true;

  styles [
    "menu",
    "device-selector-popover",
  ]

  Box {
    orientation: vertical;
    spacing: 2;

    Label {
      label: _("Playing On");
      xalign: 0;

      styles [
        "caption-heading",
        "dim-label",
        "device-selector__heading",
      ]
    }

    Box custom_content {
      orientation: vertical;
      spacing: 2;

      CheckButton this_device_button {
        sensitive: true;

        styles [
          "device-selector__row",
        ]

        child: Box {
          spacing: 10;

          Image {
            icon-name: "canto-device-computer-symbolic";
            pixel-size: 16;

            styles [
              "device-selector__icon",
            ]
          }

          Label {
            label: _("This Device");
            xalign: 0;
            hexpand: true;
          }
        };
      }

      Box devices {
        orientation: vertical;
        spacing: 2;
      }
    }

    Separator {
      orientation: horizontal;

      styles [
        "device-selector__separator",
      ]
    }

    Button refresh_button {
      action-name: "devices.refresh";

      styles [
        "flat",
        "device-selector__action",
      ]

      Box {
        spacing: 10;

        Image {
          icon-name: "view-refresh-symbolic";
          pixel-size: 16;

          styles [
            "device-selector__icon",
          ]
        }

        Label {
          label: _("Refresh Devices");
          xalign: 0;
          hexpand: true;
        }
      }
    }
  }
}
