using Gtk 4.0;
using Adw 1;

template $DetailsHeaderWidget : Widget {
  valign: start;

  styles [
    "details-header",
  ]

  Adw.BreakpointBin breakpoint_bin {
    // The narrow layout's least width: its row of buttons (play, shuffle,
    // like and pin, share, menu) takes 266, plus room for the play button
    // growing on hover. An album page is then at least 328 wide.
    width-request: 280;
    height-request: 1;
    hexpand: true;
    // A BreakpointBin clips by default, which cut the cover's shadow into a
    // hard box
    overflow: visible;

    // Narrow: stack artwork above the text/buttons instead of beside them.
    // Also under the 478 px the cover and the buttons take beside each
    // other (cover 200, gap 12, buttons 266), whatever the text scale: with
    // text at 0.91, 510sp is only 464 px.
    Adw.Breakpoint {
      condition("max-width: 510sp or max-width: 477px")

      setters {
        header_box.orientation: vertical;
        image_box.halign: center;
        image_box.valign: start;
        image_box.margin-end: 0;
        image_box.margin-bottom: 8;
        // Remove the desktop-only top padding so the text/buttons stack tightly.
        info_box.margin-top: 0;
      }
    }

    child: Box header_box {
      orientation: horizontal;

      // Not clipped itself: a clip here cut its own shadow into a hard box.
      // The rounding is on the Overlay inside.
      Box image_box {
        valign: center;
        margin-end: 12;
        width-request: 200;
        height-request: 200;

        styles [
          "details-header__image-box",
          "details-header__image-placeholder",
          "card",
        ]

        Overlay image_clip {
          overflow: hidden;

          styles [
            "details-header__image-clip",
          ]

          Image image {
            pixel-size: 200;
            halign: center;
            valign: center;

            styles [
              "details-header__image",
            ]
          }

        }
      }

      Box content_box {
        orientation: vertical;
        hexpand: true;
        // Don't propagate the spacers' vexpand: stay at natural height in the
        // narrow (vertical) layout instead of the desktop artwork height.
        vexpand: false;

        // Spacers only expand on desktop (box stretched to artwork height),
        // centering text and pushing buttons down. In the narrow layout they
        // collapse to zero so everything stacks tightly.
        Box {
          vexpand: true;
        }

        Box info_box {
          orientation: vertical;
          hexpand: true;
          // Top padding set to the height of the action buttons below, so the
          // centered text block accounts for the button row and sits optically
          // centered against the artwork on desktop. Reset to 0 by the narrow
          // breakpoint, where the layout stacks vertically.
          margin-top: 34;

          Label caption_label {
            halign: start;
            visible: false;

            styles [
              "caption",
            ]
          }

          Label title_label {
            halign: start;
            hexpand: false;
            xalign: 0;
            wrap: true;
            wrap-mode: word_char;
            lines: 2;
            ellipsize: end;

            styles [
              "title-1",
              "details-header__title",
            ]
          }

          Label subtitle_label {
            halign: start;
            visible: false;
            ellipsize: end;

            styles [
              "body",
            ]
          }

          $SubtitleLinksBox subtitle_links_box {
            halign: start;
            visible: false;

            styles [
              "body",
            ]
          }
        }

        Box {
          vexpand: true;
        }

        Box button_box {
          orientation: horizontal;
          hexpand: true;
          margin-top: 12;
          // Room for the play button's hover growth and shadow: the header
          // clips whatever goes past its edges
          margin-start: 4;
          margin-bottom: 18;

          Adw.WrapBox action_wrap {
            hexpand: true;
            child-spacing: 8;
            line-spacing: 8;
            justify: fill;
            justify-last-line: true;

            Box primary_buttons {
              orientation: horizontal;
              spacing: 8;
              halign: start;
              valign: center;

              Button play_button {
                icon-name: "media-playback-start-symbolic";
                halign: center;
                valign: center;
                visible: false;
                tooltip-text: _("Play");

                styles [
                  "circular",
                  "play__button",
                ]
              }

              Button shuffle_button {
                icon-name: "media-playlist-shuffle-symbolic";
                halign: center;
                valign: center;
                visible: false;
                tooltip-text: _("Shuffle");

                styles [
                  "circular",
                  "shuffle__button",
                ]
              }

              Button like_button {
                icon-name: "canto-heart-symbolic";
                halign: center;
                valign: center;
                visible: false;
                tooltip-text: _("Add to Library");

                styles [
                  "circular",
                  "like__button",
                ]
              }

              Button share_button {
                icon-name: "folder-publicshare-symbolic";
                halign: center;
                valign: center;
                visible: false;
                tooltip-text: _("Copy Link");

                styles [
                  "circular",
                  "share__button",
                ]
              }
            }

            Box trailing_buttons {
              orientation: horizontal;
              spacing: 8;
              halign: end;
              valign: center;
              visible: false;

              Box track_controls {
                orientation: horizontal;
                spacing: 6;
                valign: center;
                visible: false;
              }

              MenuButton menu_button {
                icon-name: "view-more-symbolic";
                halign: center;
                valign: center;
                visible: false;
                tooltip-text: _("More Options");

                styles [
                  "circular",
                  "menu__button",
                ]
              }
            }
          }
        }
      }
    };
  }
}
