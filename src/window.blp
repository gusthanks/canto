using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Canto";
  default-width: 1200;
  default-height: 720;
  height-request: 380;

  $ShellBox {
    // Keep in sync with pages/shortcuts/shortcuts.blp
    ShortcutController {
      scope: local;

      Shortcut {
        trigger: "space";
        action: "action(app.toggle_playback)";
      }

      Shortcut {
        trigger: "<Ctrl>Q";
        action: "action(app.quit)";
      }

      Shortcut {
        trigger: "<Ctrl>bracketleft";
        action: "action(app.player_prev)";
      }

      Shortcut {
        trigger: "<Ctrl>bracketright";
        action: "action(app.player_next)";
      }

      Shortcut {
        trigger: "<Ctrl>S";
        action: "action(app.toggle_shuffle)";
      }

      Shortcut {
        trigger: "<Ctrl>R";
        action: "action(app.toggle_repeat)";
      }

      Shortcut {
        trigger: "<Ctrl>M";
        action: "action(app.toggle_mute)";
      }

      Shortcut {
        trigger: "<Alt>1";
        action: "action(win.show-now-playing)";
      }

      Shortcut {
        trigger: "<Alt>2";
        action: "action(app.nav_artists)";
      }

      Shortcut {
        trigger: "<Alt>3";
        action: "action(app.nav_albums)";
      }

      Shortcut {
        trigger: "<Alt>4";
        action: "action(app.nav_playlists)";
      }

      Shortcut {
        trigger: "<Alt>5";
        action: "action(app.nav_tracks)";
      }

      Shortcut {
        trigger: "F9";
        action: "action(win.show-navigation-panel)";
      }

      Shortcut {
        trigger: "<Alt>Left|Back";
        action: "action(app.nav_back)";
      }

      Shortcut {
        trigger: "<Alt>Right|Forward";
        action: "action(app.nav_forward)";
      }

      Shortcut {
        trigger: "<Ctrl>F";
        action: "action(app.search)";
      }
    }

    ShortcutController arrow_shortcuts {
      scope: local;
      propagation-phase: capture;

      Shortcut {
        trigger: "<Ctrl>Left";
        action: "action(app.seek_backward)";
      }

      Shortcut {
        trigger: "<Ctrl>Right";
        action: "action(app.seek_forward)";
      }

      Shortcut {
        trigger: "<Ctrl>Down";
        action: "action(app.volume_down)";
      }

      Shortcut {
        trigger: "<Ctrl>Up";
        action: "action(app.volume_up)";
      }

      Shortcut {
        trigger: "<Ctrl><Shift>Left";
        action: "action(app.player_prev)";
      }

      Shortcut {
        trigger: "<Ctrl><Shift>Right";
        action: "action(app.player_next)";
      }
    }

    // The window's top bar, across the panels: back and forward, home and
    // a big search field in the middle, the main menu at the end
    Box {
      orientation: vertical;
      vexpand: true;

      Adw.HeaderBar top_bar {
        // No window buttons: Omarchy closes windows with Super+W
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        styles [
          "top-bar",
        ]

        // First, before back and forward
        MenuButton user {
          margin-end: 2;
          icon-name: "canto-more-symbolic";
          tooltip-text: _("Main Menu");
          // Opens with F10
          primary: true;
          focus-on-click: false;
          can-focus: false;
        }

        Box top_history {
          spacing: 2;
        }

        title-widget: Adw.Clamp {
          maximum-size: 460;
          tightening-threshold: 300;
          hexpand: true;

          child: Box top_center {
            spacing: 8;

            Button home_button {
              icon-name: "go-home-symbolic";
              /* Translators: Tooltip of the top bar button that opens the home page. */
              tooltip-text: _("Home");
              action-name: "app.nav_albums";
              valign: center;
              focus-on-click: false;
              can-focus: false;

              styles [
                "circular",
                "top-bar__home",
              ]
            }

            Stack top_search_stack {
              hexpand: true;
              hhomogeneous: false;

              Box top_search_entry {
                spacing: 8;

                Button search_button {
                  hexpand: true;
                  valign: center;
                  tooltip-text: _("Search");
                  focus-on-click: false;
                  can-focus: false;

                  styles [
                    "top-bar__search",
                  ]

                  child: Box {
                    spacing: 8;

                    Image {
                      icon-name: "system-search-symbolic";
                    }

                    Label {
                      /* Translators: Placeholder of the search field in the top bar. */
                      label: _("What do you want to play?");
                      ellipsize: end;
                      xalign: 0;
                    }
                  };
                }

                // Narrow windows: just a round search button
                Button top_search_icon {
                  visible: false;
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search");
                  action-name: "app.search";
                  valign: center;
                  focus-on-click: false;
                  can-focus: false;

                  styles [
                    "circular",
                    "top-bar__home",
                  ]
                }
              }

              Adw.Bin top_search_slot {
                hexpand: true;
              }
            }
          };
        };

      }

      Adw.ToastOverlay toast_overlay {
        vexpand: true;

        // Bottom sheet
        // The queue, in narrow windows: opened from the player bar's queue
        // button, with no bar of its own at the bottom
        Adw.BottomSheet bottom_sheet {
          reveal-bottom-bar: false;
          full-width: false;

          // Dropped by the narrow breakpoints (see shell/layout)
          styles [
            "bottom-sheet--padded",
          ]

          content: Adw.OverlaySplitView utility_split {
            styles [
              "canto-cards",
            ]

            sidebar-position: end;
            show-sidebar: false;
            pin-sidebar: true;
            sidebar-width-unit: px;

            // An OverlaySplitView collapses without reparenting its children,
            // which would rebuild every page
            content: Adw.OverlaySplitView navigation_split {
              styles [
                "canto-cards",
              ]

              vexpand: true;
              pin-sidebar: true;
              sidebar-width-unit: px;

              // Navigation panel
              sidebar: Box navigation_panel {
                Box {
                  orientation: vertical;
                  hexpand: true;

                  // The header of the collapsed sidebar: its buttons move here
                  // (see shell/layout)
                  Box rail_header {
                    orientation: vertical;
                    visible: false;
                    spacing: 8;
                    margin-top: 8;
                    margin-bottom: 6;
                    halign: center;

                    styles [
                      "rail-header",
                    ]

                    Button rail_expand {
                      icon-name: "canto-library-symbolic";
                      tooltip-text: _("Expand Your Library");
                      action-name: "win.sidebar-rail";
                      focus-on-click: false;
                      can-focus: false;

                      styles [
                        "flat",
                      ]
                    }
                  }

                  Adw.HeaderBar navigation_panel_header {
                    show-title: false;
                    show-start-title-buttons: false;
                    show-end-title-buttons: false;

                    styles [
                      "flat",
                    ]

                    Label library_title {
                      /* Translators: Title of the left panel, which lists the user's playlists, albums and artists. */
                      label: _("Your Library");
                      margin-start: 6;

                      styles [
                        "heading",
                      ]
                    }

                    [end]
                    Button rail_collapse {
                      icon-name: "pan-start-symbolic";
                      tooltip-text: _("Collapse Sidebar");
                      action-name: "win.sidebar-rail";
                      focus-on-click: false;
                      can-focus: false;
                    }
                  }

                  ScrolledWindow {
                    hscrollbar-policy: never;

                    ListBox home_listbox {
                      vexpand: true;

                      styles [
                        "navigation-sidebar",
                      ]
                    }
                  }
                }

                // The drag itself is on the split view (see shell/layout)
                Box navigation_resize_handle {
                  width-request: 6;

                  styles [
                    "navigation-panel__resize-handle",
                  ]
                }
              };

              // Content panel. In a ClipBin, so the panels are never squeezed
              // for it while they slide (see shell/layout/clip_bin.rs)
              content: $ClipBin {
                // The page's own bar floats over it: album, playlist and artist
              // pages run up under it, see-through until scrolled
              child: Overlay content_panel {
                  child: Stack content_stack {
                    hexpand: true;
                    vexpand: true;
                    transition-type: slide_left_right;
                  };

                  [overlay]
                  $AppHeaderBar app_header {
                    valign: start;
                  }
                };
              };
            };

            // Utility panel
            sidebar: $UtilityPanelWidget utility_panel {};
          };
        }
      }
    }

    // Playback bar, with the selection toolbar over it
    Overlay {
      hexpand: true;

      $PlaybackWidget playback {
        hexpand: true;
        vexpand: false;
      }

      [overlay]
      $SelectionToolbarWidget selection_toolbar {
        hexpand: true;
      }
    }
  }
}

Adw.AboutDialog about {
  application-name: "Canto";
  application-icon: "io.github.gusthanks.Canto";
  developer-name: "Gustavo Costa";
  /* Translators: One line under the app name in the About window. */
  comments: _("Your music services in one calm player, with synced lyrics, translations and listening stats.");
  website: "https://github.com/gusthanks/canto";
  issue-url: "https://github.com/gusthanks/canto/issues";
  license-type: mit_x11;
}

menu main_menu {
  section {
    item {
      label: _("Command Palette");
      action: "win.command-palette";
    }

    item {
      label: _("Start Track Radio");
      action: "win.start-track-radio";
    }

    item {
      label: _("Your Stats");
      action: "win.listening-stats";
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "win.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-shortcuts";
    }

    item {
      label: _("Report Issue");
      action: "menu.report-issue";
    }

    item {
      label: _("About Canto");
      action: "menu.about";
    }
  }

  section {
    item {
      label: _("Log Out");
      action: "menu.logout";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
